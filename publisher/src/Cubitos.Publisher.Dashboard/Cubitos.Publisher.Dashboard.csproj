<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows only: the panel runs next to the Windows Service on the same machine. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Cubitos.Publisher.Dashboard</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Historia en Cubitos — Panel</ApplicationTitle>
    <ApplicationId>pe.historiaencubitos.publisher.dashboard</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Unpackaged exe with the Windows App SDK bundled, so it starts without installing a runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0b1230" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <None Include="Resources\Fonts\OFL-CinzelDecorative.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cubitos.Publisher.Dashboard.Core\Cubitos.Publisher.Dashboard.Core.csproj" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8" ?>
<!--
    Left-edge navigation notch. The root only spans the collapsed tab until the panel opens (see NotchPanel.xaml.cs),
    so the area beside the tab never swallows clicks meant for the content.
-->
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:vm="clr-namespace:Cubitos.Publisher.Dashboard.ViewModels"
      x:Class="Cubitos.Publisher.Dashboard.Controls.NotchPanel"
      x:DataType="vm:MainViewModel"
      HorizontalOptions="Start" VerticalOptions="Fill" WidthRequest="58"
      InputTransparent="True" CascadeInputTransparent="False">

    <Grid.Resources>
        <Style x:Key="NotchItem" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="NotchLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{DynamicResource NotchText}" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </Grid.Resources>

    <GraphicsView x:Name="ShapeView" InputTransparent="True" />

    <!-- Hover target of the collapsed tab. -->
    <ContentView x:Name="TabHit" Background="Transparent" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="58" HeightRequest="136">
        <ContentView.GestureRecognizers>
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
            <TapGestureRecognizer Tapped="OnTabTapped" />
        </ContentView.GestureRecognizers>
    </ContentView>

    <!-- Expanded panel; its children fade and slide in one after another. -->
    <Grid x:Name="Panel" Background="Transparent" IsVisible="False" Margin="0,12" WidthRequest="264" HorizontalOptions="Start"
          RowDefinitions="132,Auto,*,Auto" Padding="18,12,22,18">
        <Grid.GestureRecognizers>
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
        </Grid.GestureRecognizers>

        <Border x:Name="PinButton" StrokeThickness="0" StrokeShape="RoundRectangle 8" Background="Transparent" Padding="4"
                HorizontalOptions="End" VerticalOptions="Start" WidthRequest="36" HeightRequest="36" ToolTipProperties.Text="Fijar el panel">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPinTapped" />
            </Border.GestureRecognizers>
            <GraphicsView x:Name="PinView" InputTransparent="True" />
        </Border>

        <VerticalStackLayout x:Name="Brand" Grid.Row="1" Spacing="0" Margin="6,0,0,18" HorizontalOptions="Center">
            <Label Text="HISTORIA EN" FontFamily="{DynamicResource HeadingFont}" FontSize="14" TextColor="{DynamicResource NotchText}" HorizontalTextAlignment="Center" />
            <Label Text="CUBITOS" FontFamily="{DynamicResource HeadingFont}" FontSize="30" TextColor="{DynamicResource Accent}" HorizontalTextAlignment="Center" />
            <Label Text="{DynamicResource T_BrandSubtitle}" FontFamily="{DynamicResource BodyFont}" FontSize="13" TextColor="{DynamicResource NotchMuted}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <Border x:Name="Nav0" Style="{StaticResource NotchItem}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsRanking}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NotchSelected}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="ranking" />
                </Border.GestureRecognizers>
                <Label Text="{DynamicResource T_Nav_Ranking}" Style="{StaticResource NotchLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsRanking}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource NotchSelectedText}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
            <Border x:Name="Nav1" Style="{StaticResource NotchItem}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsHeatmap}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NotchSelected}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="heatmap" />
                </Border.GestureRecognizers>
                <Label Text="{DynamicResource T_Nav_Heatmap}" Style="{StaticResource NotchLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsHeatmap}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource NotchSelectedText}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
            <Border x:Name="Nav2" Style="{StaticResource NotchItem}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsFirstDay}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NotchSelected}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="firstday" />
                </Border.GestureRecognizers>
                <Label Text="{DynamicResource T_Nav_FirstDay}" Style="{StaticResource NotchLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsFirstDay}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource NotchSelectedText}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
            <Border x:Name="Nav3" Style="{StaticResource NotchItem}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsQueue}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NotchSelected}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="queue" />
                </Border.GestureRecognizers>
                <Label Text="{DynamicResource T_Nav_Queue}" Style="{StaticResource NotchLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsQueue}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource NotchSelectedText}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="DbInfo" Grid.Row="3" Spacing="3">
            <Label Text="Base de datos (solo lectura)" FontFamily="{DynamicResource BodyFont}" FontSize="11" TextColor="{DynamicResource NotchMuted}" />
            <Label Text="{Binding DatabasePath}" FontFamily="{DynamicResource BodyFont}" FontSize="11" TextColor="{DynamicResource NotchMuted}" LineBreakMode="CharacterWrap" />
        </VerticalStackLayout>
    </Grid>
</Grid>

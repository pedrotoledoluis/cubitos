<Window x:Class="Cubitos.Publisher.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Cubitos.Publisher.Desktop.Controls"
        xmlns:r="clr-namespace:Cubitos.Publisher.Desktop.Rendering"
        xmlns:notch="clr-namespace:Cubitos.Publisher.Desktop.Notch"
        Title="Historia en Cubitos — Panel"
        Width="1440" Height="900" MinWidth="1100" MinHeight="720"
        Left="-32000" Top="-32000" WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        Icon="/appicon.png"
        Background="{DynamicResource TitleBarBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResize">

    <!-- Custom chrome: the whole window is client area; the top 40 px drag like a title bar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Section tabs of the header (they replace the old in-window notch navigation). -->
        <Style x:Key="SectionTab" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource PageMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" CornerRadius="10,10,0,0" Padding="16,9">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="NoWrap" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NotchHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource PageText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NotchHover}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource PageText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- First item of the ranking list: title, podium and column headers (scrolls with the rows). -->
        <StackPanel x:Key="RankingHeader" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource T_Title_Ranking}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{DynamicResource T_Sub_Ranking}" Style="{StaticResource SectionSub}" Margin="0,4,0,8" />
            <TextBlock Text="Todavía no hay estadísticas de videos." Style="{StaticResource SectionSub}" FontSize="16"
                       Visibility="{Binding HasRanking, Converter={StaticResource InverseBoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Podium}" Margin="0,14,0,16" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:PodiumPanel Spacing="18" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="c:PodiumPanel.Order" Value="{Binding PodiumOrder}" />
                        <Setter Property="c:PodiumPanel.Lift" Value="{Binding PodiumLift}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:Card IsHighlighted="{Binding IsFirst}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:Crest Position="{Binding Position}" Width="62" Height="62" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Clamp2}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,8">
                                    <c:AnimatedNumber Value="{Binding TotalViews}" Style="{StaticResource KpiValue}" FontSize="32" />
                                    <TextBlock Text="vistas" Style="{StaticResource CardLabel}" FontSize="14" VerticalAlignment="Bottom" Margin="8,0,0,7" />
                                </StackPanel>
                                <c:EvenWrapPanel Grid.Row="2" Grid.ColumnSpan="2" MinItemWidth="78" ColumnSpacing="8" RowSpacing="6">
                                    <StackPanel>
                                        <TextBlock Text="+1 h" Style="{StaticResource CardLabel}" />
                                        <c:AnimatedNumber Value="{Binding Last1h}" StyleKind="Delta" Style="{StaticResource CardValue}" Foreground="{DynamicResource Positive}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="+24 h" Style="{StaticResource CardLabel}" />
                                        <c:AnimatedNumber Value="{Binding Last24h}" StyleKind="Delta" Style="{StaticResource CardValue}" Foreground="{DynamicResource Positive}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Me gusta" Style="{StaticResource CardLabel}" />
                                        <c:AnimatedNumber Value="{Binding Likes}" Style="{StaticResource CardValue}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Comentarios" Style="{StaticResource CardLabel}" />
                                        <c:AnimatedNumber Value="{Binding Comments}" Style="{StaticResource CardValue}" />
                                    </StackPanel>
                                </c:EvenWrapPanel>
                                <c:Sparkline Grid.Row="3" Grid.ColumnSpan="2" Values="{Binding Sparkline}" Height="38" Margin="0,8,0,0" />
                            </Grid>
                        </c:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="{DynamicResource RankHeaderPadding}" Visibility="{Binding HasRanking, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="3.2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.7*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Video" Style="{StaticResource ColumnHeader}" TextAlignment="Left" Margin="12,0,0,0" />
                <TextBlock Grid.Column="2" Text="Vistas" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="3" Text="+1 h" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="4" Text="+24 h" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="5" Text="Me gusta" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="6" Text="Comentarios" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="7" Text="Últimas 24 h" Style="{StaticResource ColumnHeader}" TextAlignment="Center" />
            </Grid>
        </StackPanel>
    </Window.Resources>

    <Grid x:Name="Frame">
        <!-- Scene: everything that is drawn (also what the screenshot switch renders). -->
        <Grid x:Name="Scene" Background="{DynamicResource PageBackground}" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Animated / decorative background layer (embers, glow orbs, lanterns, neon grid). -->
            <r:AmbientLayer x:Name="Ambient" Grid.RowSpan="2" />

            <!-- Light burst on the left edge while the panel comes out of (or goes back into) the notch. -->
            <notch:EmergeGlow x:Name="Emerge" Grid.RowSpan="2" />

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Background="{DynamicResource TitleBarBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="/appicon.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="HISTORIA EN CUBITOS" Margin="10,0,0,0" FontFamily="{DynamicResource HeadingFont}" FontSize="13"
                               Foreground="{DynamicResource PageText}" VerticalAlignment="Center" />
                    <TextBlock Text="· Panel" Margin="6,0,0,0" FontFamily="{DynamicResource BodyFont}" FontSize="13"
                               Foreground="{DynamicResource PageMuted}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse x:Name="LoadingDot" Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource SectionSub}" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="Tema" Style="{StaticResource SectionSub}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ThemePicker" Width="210" ItemsSource="{Binding Themes}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding Theme, Mode=TwoWay}" MinHeight="28" />
                </StackPanel>

                <Button Grid.Column="4" Content="Actualizar" Style="{StaticResource AccentButton}" Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="PinButton" Style="{StaticResource ChromeButton}" Click="OnPinClicked" ToolTip="Fijar el panel (deja de cerrarse solo)">
                        <notch:PinIcon x:Name="PinGlyph" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="MinButton" Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Minimizar">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Click="OnMaximize" ToolTip="Maximizar">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="Cerrar">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main area; the left gutter leaves room for the screen notch that overlaps the panel's left edge. -->
            <Grid x:Name="ContentHost" Grid.Row="1" Margin="76,0,0,0">
                <Grid Margin="24,12,28,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Section tabs -->
                    <StackPanel x:Name="Tabs" Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="Tab0" Style="{StaticResource SectionTab}" GroupName="sections" Tag="ranking" Content="{DynamicResource T_Nav_Ranking}" Click="OnTabClicked" />
                        <RadioButton x:Name="Tab1" Style="{StaticResource SectionTab}" GroupName="sections" Tag="heatmap" Content="{DynamicResource T_Nav_Heatmap}" Click="OnTabClicked" />
                        <RadioButton x:Name="Tab2" Style="{StaticResource SectionTab}" GroupName="sections" Tag="firstday" Content="{DynamicResource T_Nav_FirstDay}" Click="OnTabClicked" />
                        <RadioButton x:Name="Tab3" Style="{StaticResource SectionTab}" GroupName="sections" Tag="queue" Content="{DynamicResource T_Nav_Queue}" Click="OnTabClicked" />
                    </StackPanel>

                    <!-- KPIs -->
                    <Grid Grid.Row="1" Margin="0,0,14,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.7*" />
                        </Grid.ColumnDefinitions>
                        <c:Card Margin="0,0,18,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource T_Kpi_Total}" Style="{StaticResource CardLabel}" FontSize="13" />
                                <c:AnimatedNumber Value="{Binding TotalViews}" Style="{StaticResource KpiValue}" Margin="0,2,0,0" />
                            </StackPanel>
                        </c:Card>
                        <c:Card Grid.Column="1" Margin="0,0,18,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource T_Kpi_Today}" Style="{StaticResource CardLabel}" FontSize="13" />
                                <c:AnimatedNumber Value="{Binding ViewsToday}" Style="{StaticResource KpiValue}" Margin="0,2,0,0" />
                            </StackPanel>
                        </c:Card>
                        <c:Card Grid.Column="2" Margin="0,0,18,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource T_Kpi_Videos}" Style="{StaticResource CardLabel}" FontSize="13" />
                                <c:AnimatedNumber Value="{Binding VideosPublished}" Style="{StaticResource KpiValue}" Margin="0,2,0,0" />
                            </StackPanel>
                        </c:Card>
                        <c:Card Grid.Column="3" IsHighlighted="True">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource T_Kpi_Next}" Style="{StaticResource CardLabel}" FontSize="13" />
                                <TextBlock Text="{Binding NextPublishTitle}" Style="{StaticResource Clamp2}" FontFamily="{DynamicResource HeadingFont}"
                                           FontSize="16" LineHeight="21" MaxHeight="42" Margin="0,3,0,0" />
                                <!-- One text block, so the countdown drops to its own line only when it does not fit. -->
                                <TextBlock Style="{StaticResource CardLabel}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0">
                                    <Run Text="{Binding NextPublishWhen, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding NextPublishCountdown, Mode=OneWay}" FontFamily="{DynamicResource HeadingFont}" FontSize="18" Foreground="{DynamicResource Highlight}" />
                                </TextBlock>
                            </StackPanel>
                        </c:Card>
                    </Grid>

                    <!-- Sections: only one is visible; MainWindow fades/slides them on switch. -->
                    <Grid x:Name="SectionHost" Grid.Row="2" Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">

                        <!-- 1. Ranking: one virtualized list (header element + rows) so off-screen rows cost no layout. -->
                        <ItemsControl x:Name="RankingSection" Visibility="Collapsed" Focusable="False" Padding="0,0,14,18"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                                      VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <ItemsPresenter Margin="{TemplateBinding Padding}" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                        <c:Card Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="3.2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.7*" />
                                                </Grid.ColumnDefinitions>
                                                <c:Crest Position="{Binding Position}" Width="50" Height="50" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Clamp2}" Margin="12,0,12,0" VerticalAlignment="Center" />
                                                <c:AnimatedNumber Grid.Column="2" Value="{Binding TotalViews}" Style="{StaticResource CardValue}" Foreground="{DynamicResource Accent}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <c:AnimatedNumber Grid.Column="3" Value="{Binding Last1h}" StyleKind="Delta" Style="{StaticResource CardValue}" Foreground="{DynamicResource Positive}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <c:AnimatedNumber Grid.Column="4" Value="{Binding Last24h}" StyleKind="Delta" Style="{StaticResource CardValue}" Foreground="{DynamicResource Positive}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <c:AnimatedNumber Grid.Column="5" Value="{Binding Likes}" Style="{StaticResource CardValue}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <c:AnimatedNumber Grid.Column="6" Value="{Binding Comments}" Style="{StaticResource CardValue}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <c:Sparkline Grid.Column="7" Values="{Binding Sparkline}" Height="40" Margin="12,0,0,0" />
                                            </Grid>
                                        </c:Card>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 2. Peak hours -->
                        <ScrollViewer x:Name="HeatmapSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
                            <StackPanel Margin="0,0,14,18">
                                <TextBlock Text="{DynamicResource T_Title_Heatmap}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource T_Sub_Heatmap}" Style="{StaticResource SectionSub}" Margin="0,4,0,14" />
                                <c:Card>
                                    <c:HeatmapChart Model="{Binding Heatmap}" AspectRatio="0.30" MinHeight="300" MaxHeight="620" />
                                </c:Card>
                                <TextBlock Text="{DynamicResource T_BestHours}" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,22,0,12" />
                                <TextBlock Text="Todavía no hay suficientes datos para recomendar horas." Style="{StaticResource SectionSub}"
                                           Visibility="{Binding HasBestHours, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding BestHours}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <c:EvenWrapPanel MinItemWidth="230" ColumnSpacing="18" RowSpacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <c:Card>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Rank}" Style="{StaticResource KpiValue}" FontSize="40" Foreground="{DynamicResource Highlight}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding Range}" Style="{StaticResource CardValue}" FontSize="22" />
                                                        <TextBlock Text="{Binding Views}" Style="{StaticResource CardLabel}" FontSize="13" />
                                                    </StackPanel>
                                                </Grid>
                                            </c:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 3. First 24 hours -->
                        <ScrollViewer x:Name="FirstDaySection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
                            <StackPanel Margin="0,0,14,18">
                                <TextBlock Text="{DynamicResource T_Title_FirstDay}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource T_Sub_FirstDay}" Style="{StaticResource SectionSub}" Margin="0,4,0,14" />
                                <TextBlock Text="Todavía no hay videos con fecha de publicación y estadísticas de su primer día." Style="{StaticResource SectionSub}" FontSize="16"
                                           Visibility="{Binding HasLaunchOptions, Converter={StaticResource InverseBoolToVisibility}}" />
                                <c:Card Visibility="{Binding HasLaunchOptions, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Video" Style="{StaticResource CardLabel}" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <ComboBox x:Name="LaunchPicker" Grid.Column="1" ItemsSource="{Binding LaunchOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLaunch, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Rectangle Width="22" Height="4" Fill="{DynamicResource ChartPrimary}" VerticalAlignment="Center" />
                                                <TextBlock Text="Este video" Style="{StaticResource CardLabel}" FontSize="13" Margin="6,0,16,0" />
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasAverage, Converter={StaticResource BoolToVisibility}}">
                                                    <Rectangle Width="22" Height="4" Fill="{DynamicResource ChartSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Promedio del canal" Style="{StaticResource CardLabel}" FontSize="13" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <c:FirstDayChart Video="{Binding SelectedLaunch.Curve.Cumulative}" Average="{Binding ChannelAverage}"
                                                         AspectRatio="0.36" MinHeight="320" MaxHeight="640" />
                                        <TextBlock Text="{Binding LaunchSummary}" Style="{StaticResource SectionSub}" Foreground="{DynamicResource CardText}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </c:Card>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 4. Queue -->
                        <ScrollViewer x:Name="QueueSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
                            <StackPanel Margin="0,0,14,18">
                                <TextBlock Text="{DynamicResource T_Title_Queue}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource T_Sub_Queue}" Style="{StaticResource SectionSub}" Margin="0,4,0,14" />
                                <TextBlock Text="La cola está vacía." Style="{StaticResource SectionSub}" FontSize="16"
                                           Visibility="{Binding HasQueue, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Queue}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <c:Card Opacity="{Binding RowOpacity}" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding BadgeBackground}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="2"
                                                            CornerRadius="{DynamicResource BadgeCornerRadius}" Padding="12,7" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding BadgeText}" FontFamily="{DynamicResource HeadingFont}" FontSize="13" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,18,0">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Clamp2}" FontSize="16" LineHeight="21" MaxHeight="42" />
                                                        <TextBlock Text="{Binding Episode}" Style="{StaticResource CardLabel}" Margin="0,2,0,0" />
                                                        <TextBlock Style="{StaticResource CardLabel}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0">
                                                            <Run Text="Publicación: " />
                                                            <Run Text="{Binding PublishAt, Mode=OneWay}" />
                                                            <Run Text="  " />
                                                            <Run Text="{Binding PublishRelative, Mode=OneWay}" Foreground="{DynamicResource Highlight}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding RetryAt}" Style="{StaticResource CardLabel}" FontSize="13" Visibility="{Binding RetryVisibility}" />
                                                        <TextBlock Text="{Binding Replaces}" Style="{StaticResource CardLabel}" FontSize="13" Visibility="{Binding ReplacesVisibility}" />
                                                        <TextBlock Text="{Binding LastError}" FontSize="13" Foreground="{DynamicResource Highlight}" FontFamily="{DynamicResource BodyFont}"
                                                                   Visibility="{Binding ErrorVisibility}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Content="Ver video" Style="{StaticResource AccentButton}" Visibility="{Binding VideoVisibility}"
                                                                Command="{Binding DataContext.OpenVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding VideoUrl}" Margin="0,0,0,6" />
                                                        <TextBlock Text="{Binding Attempts}" Style="{StaticResource CardLabel}" TextAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </c:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Empty state -->
                    <c:Card Grid.Row="2" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource CardValue}" FontSize="24" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource CardLabel}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </c:Card>
                </Grid>
            </Grid>

            <!-- Snapshot of the previous theme, faded out over the new one. -->
            <Image x:Name="ThemeFade" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed" Stretch="Fill" />
        </Grid>
    </Grid>
</Window>

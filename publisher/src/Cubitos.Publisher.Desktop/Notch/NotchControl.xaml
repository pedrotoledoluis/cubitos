<!--
    Left-edge navigation notch with the flaming pumpkin. The control is only as wide as the tab until the panel opens
    (see NotchControl.xaml.cs), and areas without a background are not hit-testable, so the space beside the tab never
    swallows clicks meant for the content. Self-contained on purpose: it will be redesigned from a reference notch.
-->
<UserControl x:Class="Cubitos.Publisher.Desktop.Notch.NotchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notch="clr-namespace:Cubitos.Publisher.Desktop.Notch"
             HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="58">

    <UserControl.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource NotchText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="14,11">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NotchHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NotchSelected}" />
                                <Setter Property="Foreground" Value="{DynamicResource NotchSelectedText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <notch:NotchSurface x:Name="Surface" />

        <!-- Hover target of the collapsed tab. -->
        <Border x:Name="TabHit" Background="Transparent" Width="58" Height="136" HorizontalAlignment="Left" VerticalAlignment="Center"
                Cursor="Hand" MouseEnter="OnPointerEntered" MouseLeftButtonUp="OnTabClicked" />

        <!-- Expanded panel; its children fade and slide in one after another. -->
        <Grid x:Name="Panel" Background="Transparent" Width="264" Margin="0,12" HorizontalAlignment="Left" Visibility="Collapsed"
              MouseEnter="OnPointerEntered">
            <Grid Margin="18,12,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="132" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="PinButton" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Fijar el panel" Click="OnPinClicked" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="4">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NotchHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <notch:PinIcon x:Name="Pin" />
                </Button>

                <StackPanel x:Name="Brand" Grid.Row="1" Margin="6,0,0,18" HorizontalAlignment="Center">
                    <TextBlock Text="HISTORIA EN" FontFamily="{DynamicResource HeadingFont}" FontSize="14" Foreground="{DynamicResource NotchText}" HorizontalAlignment="Center" />
                    <TextBlock Text="CUBITOS" FontFamily="{DynamicResource HeadingFont}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource T_BrandSubtitle}" FontFamily="{DynamicResource BodyFont}" FontSize="13" Foreground="{DynamicResource NotchMuted}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="Nav0" Style="{StaticResource NavItem}" GroupName="notch-nav" Tag="ranking" Content="{DynamicResource T_Nav_Ranking}" Click="OnNavClicked" Margin="0,0,0,6" />
                    <RadioButton x:Name="Nav1" Style="{StaticResource NavItem}" GroupName="notch-nav" Tag="heatmap" Content="{DynamicResource T_Nav_Heatmap}" Click="OnNavClicked" Margin="0,0,0,6" />
                    <RadioButton x:Name="Nav2" Style="{StaticResource NavItem}" GroupName="notch-nav" Tag="firstday" Content="{DynamicResource T_Nav_FirstDay}" Click="OnNavClicked" Margin="0,0,0,6" />
                    <RadioButton x:Name="Nav3" Style="{StaticResource NavItem}" GroupName="notch-nav" Tag="queue" Content="{DynamicResource T_Nav_Queue}" Click="OnNavClicked" />
                </StackPanel>

                <StackPanel x:Name="DbInfo" Grid.Row="3">
                    <TextBlock Text="Base de datos (solo lectura)" FontFamily="{DynamicResource BodyFont}" FontSize="11" Foreground="{DynamicResource NotchMuted}" />
                    <TextBlock x:Name="DbPathText" FontFamily="{DynamicResource BodyFont}" FontSize="11" Foreground="{DynamicResource NotchMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

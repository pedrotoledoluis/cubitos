  "hashtags": ["#Shorts", "#historia", "#curiosidades"],
  "tags": ["historia", "emperador norton", "joshua norton", "san francisco", "estados unidos", "curiosidades", "humor", "historia en cubitos"],
  "lines": [
    { "speaker": "tito", "text": "¿Estados Unidos tuvo un emperador?", "shot": "wide", "emotion": "surprised" },
    { "speaker": "profe", "location": "sanfrancisco1870", "text": "Uno. Joshua Norton. San Francisco, 1859.", "say": "Uno. Yóshua Norton. San Francisco, mil ochocientos cincuenta y nueve.",
      "board": { "scene": "mapPin2", "map": "usa", "pin": [170, 360], "label": "SAN FRANCISCO", "labelDx": 150, "icon": "crown", "iconAt": [560, 360], "iconScale": 0.9, "title": "1859" },
      "titoEmotion": "surprised" },
    { "speaker": "tito", "text": "¿Y quién lo eligió?", "emotion": "skeptical" },
    { "speaker": "profe", "text": "Él mismo. Mandó una carta al diario proclamándose \"Emperador de los Estados Unidos\".", "say": "Él mismo. Mandó una carta al diario proclamándose Emperador de los Estados Unidos.",
      "board": { "scene": "newspaper", "masthead": "SAN FRANCISCO BULLETIN", "date": "17 DE SEPTIEMBRE DE 1859", "headline": "EMPERADOR", "sub": "DE LOS ESTADOS UNIDOS" },
      "titoEmotion": "surprised", "sfx": [["ding", 1.0]] },
    { "speaker": "tito", "text": "¿Y el diario la publicó?", "emotion": "surprised" },
    { "speaker": "profe", "text": "Sí. Por diversión.", "pose": "shrug", "titoEmotion": "happy" },
    { "speaker": "tito", "text": "Bueno, un chiste de un día.", "emotion": "happy" },
    { "speaker": "profe", "text": "Duró veintiún años. Se hizo un uniforme militar con charreteras doradas y un sombrero con pluma.", "pose": "wave", "titoEmotion": "surprised", "sfx": [["pop", 0.6]] },
    { "speaker": "tito", "text": "¿Y qué hacía un emperador?", "emotion": "neutral" },
    { "speaker": "profe", "text": "Decretos. Ordenó disolver el Congreso.",
      "board": { "scene": "decree", "label": "DECRETO", "icon": "capitol", "title": "CONGRESO: DISUELTO" }, "titoEmotion": "scared" },
    { "speaker": "tito", "text": "¿Y el Congreso?", "emotion": "skeptical" },
    { "speaker": "profe", "text": "Ni se enteró.", "pose": "shrug", "titoEmotion": "happy", "sfx": [["boing", 0.4]] },
    { "speaker": "tito", "text": "Normal.", "emotion": "skeptical" },
    { "speaker": "profe", "text": "También imprimió su propio dinero. Y varios negocios de San Francisco lo aceptaban.",
      "board": { "scene": "banknote", "value": "50 ¢", "label": "IMPERIO DE NORTON", "face": "norton" }, "titoEmotion": "surprised", "sfx": [["ding", 1.2]] },
    { "speaker": "tito", "text": "¡Tenía su propia moneda!", "emotion": "surprised" },
    { "speaker": "profe", "text": "Según las crónicas, comía gratis en restaurantes. Y la ciudad le pagó un uniforme nuevo cuando el suyo se gastó.", "pose": "explain", "titoEmotion": "happy" },
    { "speaker": "tito", "text": "Este señor ganó la vida.", "emotion": "happy" },
    { "speaker": "profe", "text": "Ordenó construir un puente que cruzara la bahía de San Francisco.",
      "board": { "scene": "bridge", "left": "SAN FRANCISCO", "right": "OAKLAND", "title": "DECRETO: ¡UN PUENTE!" }, "titoEmotion": "skeptical" },
    { "speaker": "tito", "text": "¿Y se rieron de él?", "emotion": "skeptical" },
    { "speaker": "profe", "text": "Sí. Décadas después, construyeron el puente.", "pose": "shrug", "titoEmotion": "surprised", "sfx": [["ding", 0.9]] },
    { "speaker": "tito", "text": "¡Era un visionario!", "emotion": "surprised" },
    { "speaker": "profe", "text": "Cuando murió, en 1880, entre diez mil y treinta mil personas fueron a su funeral.", "say": "Cuando murió, en mil ochocientos ochenta, entre diez mil y treinta mil personas fueron a su funeral.", "shot": "wide", "dutch": true, "titoEmotion": "surprised" },
    { "speaker": "tito", "text": "Más que a mi cumpleaños.", "emotion": "skeptical", "profePose": "facepalm" }
  ]
}

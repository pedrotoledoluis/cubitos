  "id": "006-emperador-norton",
  "title": "El hombre que se proclamó Emperador de Estados Unidos… y la ciudad le siguió el juego",
  "thumbnailText": "¡SE AUTOPROCLAMÓ *EMPERADOR*!",
  "thumbnailBoard": { "scene": "newspaper", "masthead": "SAN FRANCISCO BULLETIN", "date": "1859", "headline": "EMPERADOR", "sub": "DE LOS ESTADOS UNIDOS" },
